# Fil — modèle de configuration. Copie-le en .env et remplis les valeurs.
# Aucune valeur secrète ici. Les clés IA et SUPABASE_SECRET_KEY restent côté serveur.

# --- IA : deux fournisseurs compatibles OpenAI ---------------------------------
DEEPSEEK_API_KEY=                   # clé API DeepSeek (fournisseur principal)
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro      # génération (fiches, quiz, découpage)
DEEPSEEK_LIGHT_MODEL=deepseek-flash # tâches légères : vérification, tuteur, Feynman
META_API_KEY=                       # clé API Meta (secours, et dictée muse-voice-transcribe)
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3-contributor
AI_PRIMARY_PROVIDER=deepseek        # deepseek | meta | mock (simulé, déterministe)
AI_FALLBACK_PROVIDER=meta           # deepseek | meta | mock | none
AI_DAILY_BUDGET_USD=2               # plafond de dépense IA par jour (heure de Paris)
AI_CONFIRM_THRESHOLD_USD=0.3        # au-delà, un cours attend une confirmation avant génération
# AI_PRICING_JSON={"deepseek-v4-pro":{"input":1.74,"output":3.48}}   # prix USD / million de tokens

# --- Supabase cloud (production) ------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=           # https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY= # sb_publishable_...
SUPABASE_SECRET_KEY=                # sb_secret_... (serveur uniquement)
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=              # jeton personnel (CLI / API Management), jamais envoyé à l'app
SUPABASE_DB_PASSWORD=               # pour supabase db push

# --- Vercel ---------------------------------------------------------------------
VERCEL_TOKEN=                       # déploiement non interactif, jamais envoyé à l'app

# --- Accès : seuls ces e-mails peuvent créer un compte (séparés par des virgules)
ALLOWED_EMAILS=

# --- Secrets internes : générés par `pnpm gen:secrets` --------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=       # clé publique des notifications push
VAPID_PRIVATE_KEY=                  # clé privée des notifications push
VAPID_SUBJECT=                      # mailto:<premier e-mail autorisé>
CRON_SECRET=                        # protège /api/jobs/tick et /api/cron/* (Supabase Cron, Vercel Cron)
JOBS_SECRET=                        # protège l'appel interne du worker de jobs

# --- Optionnel -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=               # URL publique (sinon déduite de Vercel)
SMTP_CONFIGURED=                    # 1 si un SMTP personnalisé est branché : e-mails Auth en français
LOG_LEVEL=                          # debug | info | warn | error
IMPORT_CONCURRENCY=6                # traitements parallèles de pnpm import:cours
