{
  "name": "fil-revision",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:local": "tsx scripts/with-env.ts .env.localstack -- next start",
    "build:local": "tsx scripts/with-env.ts .env.localstack -- next build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "db:reset": "supabase db reset && tsx scripts/sync-allowlist.ts",
    "db:types": "supabase gen types typescript --local > src/lib/database.types.ts && prettier --write src/lib/database.types.ts",
    "env:local": "tsx scripts/env-local.ts",
    "gen:secrets": "tsx scripts/gen-secrets.ts",
    "allowlist:sync": "tsx scripts/sync-allowlist.ts",
    "import:cours": "tsx --conditions=react-server scripts/import-cours.ts",
    "audit:photo": "tsx scripts/audit-photosensitive.ts",
    "audit:secrets": "tsx scripts/check-client-secrets.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm test && pnpm audit:photo",
    "dev:user": "tsx scripts/dev-user.ts",
    "setup:prod": "tsx scripts/setup-prod.ts",
    "vercel:env": "tsx scripts/vercel-env.ts",
    "audit:content": "tsx --conditions=react-server scripts/audit-content.ts"
  },
  "dependencies": {
    "@fontsource/opendyslexic": "5.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "get-nonce": "^1.0.1",
    "idb": "^8.0.4",
    "jszip": "^3.10.2",
    "lucide-react": "^1.68.0",
    "mammoth": "^1.13.0",
    "next": "16.4.5",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sql.js": "1.13.0",
    "sucrase": "^3.35.1",
    "tailwind-merge": "^3.7.0",
    "ts-fsrs": "^6.0.0",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^2.1.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sql.js": "^1.4.11",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^5.1.0",
    "dotenv": "^18.0.9",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "4.23.0",
    "supabase": "3.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@10.34.6",
  "type": "module",
  "engines": {
    "node": "24.x"
  }
}
